{
  "version": "2.0",
  "description": "Vectoris Numerics Public API and Template Instantiation Surface Manifest with declared Dynamics semantic contracts",
  "scope": "All ISO C++20 pure-mathematics production headers for VectorisNumerics",
  "guarantees": {
    "claim": "Declared supported public API instantiation surface verified at compile-time and run-time.",
    "disclaimer": "This manifest guarantees verification of the declared supported instantiation families (float, double, standard Frame tags, standard SI quantities). It does not claim mathematical exhaustiveness over arbitrary user-defined types or infinite template permutations."
  },
  "supported_types_matrix": {
    "floating_point_scalars": [
      "float",
      "double"
    ],
    "representative_frames": [
      "WorldFrame",
      "BodyFrame",
      "SensorFrame"
    ],
    "base_units": [
      "Amount (Mole)",
      "Angle (Radian)",
      "Current (Ampere)",
      "Length (Meter)",
      "Luminosity (Candela)",
      "Mass (Kilogram)",
