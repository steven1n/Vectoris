      "AngularMomentum",
      "AngularVelocity",
      "Force",
      "Frequency",
      "MomentOfInertia",
      "Power",
      "Torque",
      "Velocity"
    ],
    "result_payloads": {
      "alternatives": "Distinct std::variant-compatible T/E with nonthrowing destructors; Result<T,T> rejected.",
      "construction": "Selected payload constructible from forwarded arguments; throwing construction, move-only, non-default and immovable in-place payloads supported.",
      "copy_assignment": "Both alternatives copy constructible and copy assignable; each has nothrow copy construction OR nothrow move construction.",
      "move_assignment": "Both alternatives move constructible and move assignable; both have nothrow move construction.",
      "exceptions": "Cross-state failed copy construction preserves destination; same-state throwing assignment retains alternative with payload guarantee. Unsafe assignments are deleted.",
      "positive_probe": "PublicApiSurfaceTest.CoreResultTwoStatePayloadPolicy",
      "detailed_tests": "modules/VectorisNumerics/tests/Core/ResultExceptionTest.cpp"
    },
    "sqrt": {
      "canonical": "vectoris::numerics::core::sqrt",
      "compatibility": "vectoris::numerics::core::Math::sqrt forwards; PascalCase Core retained; not deprecated",
      "runtime": [
        "float",
        "double",
        "long double"
      ],
      "portable_CXX20_constexpr": [
        "float",
        "double"
      ],
      "rejected_deduced_arguments": [
        "integral",
        "bool",
        "user-defined conversion types"
      ],
      "special_values": "signed zero and +Inf preserved; negative nonzero and NaN inputs produce NaN",
      "accuracy_validation": "<=1 ULP against independent std::sqrt in round-to-nearest; no cross-platform bit-identity or NaN-payload guarantee"
    }
  },
